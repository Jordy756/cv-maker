---
import '@styles/global.css';
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCurrentLocale, interpolate, locales, useTranslations, useResume } from '@i18n/utils';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { basics } = useResume(currentLocale);
const { name } = basics;

const url = Astro.url;
const ogImage =
  'https://res.cloudinary.com/dygwpgeq9/image/upload/v1772054096/minimalist_portfolio_en_og_img_ow7ugd.webp';
const alternateUrl = (locale: string) => new URL(getRelativeLocaleUrl(locale), Astro.site!).toString();
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-primary" preload />

    <link rel="canonical" href={url} />
    {locales.map((locale) => (
      <link rel="alternate" hreflang={locale} href={alternateUrl(locale)} />
    ))}

    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={interpolate(t('meta.name'), { name })} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={interpolate(t('meta.title'), { name })} />
    <meta property="og:description" content={interpolate(t('meta.description'), { name })} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="760" />
    <meta property="og:image:height" content="430" />
    <meta property="og:locale" content={t('meta.locale')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={interpolate(t('meta.title'), { name })} />
    <meta name="twitter:description" content={interpolate(t('meta.description'), { name })} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="font-sans text-pretty text-xs bg-neutral-800 print:bg-white">
    <div class="p-6 w-204 mx-auto min-h-dvh print:min-h-0 flex flex-col gap-4 bg-white text-black">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @page {
    size: 8.5in 11in;
    margin: 0;
  }
</style>
