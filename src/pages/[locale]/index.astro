---
import Layout from '@layouts/Layout.astro';
import Header from '@components/chrome/Header.astro';
import Experience from '@components/sections/Experience.astro';
import Education from '@components/sections/Education.astro';
import Skills from '@components/sections/Skills.astro';
import { getCurrentLocale, interpolate, useTranslations, useResume } from '@i18n/utils';

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }];
}

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { basics, summary } = useResume(locale);
---

<Layout title={interpolate(t('meta.title'), { name: basics.name })} description={summary}>
  <Header />
  <main>
    <Experience />
  </main>

  <!--

  <Section title={t('education.title')}>
    <Education entries={cv.education} locale={cv.locale} presentLabel={t('labels.present')} />
  </Section>

  <Section title={t('skills.title')}>
    <Skills groups={cv.skills} />
  </Section> -->
</Layout>
