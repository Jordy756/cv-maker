---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="mt-[10.4pt] mb-0 list-none pl-0 text-[11.33pt] leading-[1.16]">
  {items.map((item) => (
    <li class="relative pl-[36pt] before:absolute before:left-[18pt] before:top-[-0.15pt] before:content-['\25CF'] before:font-[Liberation_Sans,Arial,Helvetica,sans-serif] before:not-italic before:font-normal">
      {item}
    </li>
  ))}
</ul>
