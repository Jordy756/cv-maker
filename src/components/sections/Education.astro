---
import { formatRange } from '@scripts/utils/dates';
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useTranslations, useResume } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { educations } = useResume(locale);
---

<Section title={t('education.title')}>
  {educations.map(({ institution, area, location, startDate, endDate }) => (
    <article>
      <header class="flex gap-4 justify-between">
        <h3 class="font-bold">{institution}</h3>
        <span class="whitespace-nowrap">{location}</span>
      </header>
      <div class="flex justify-between gap-4">
        <h4 class="font-normal">{area}</h4>
        <span class="whitespace-nowrap">{formatRange(startDate, endDate, locale, t('labels.present'))}</span>
      </div>
    </article>
  ))}
</Section>
