---
import type { ExperienceEntry } from '@lib/cv';
import { formatRange } from '@lib/cv';
import EntryRow from '@components/ui/EntryRow.astro';
import Bullets from '@components/ui/Bullets.astro';

interface Props {
  entries: ExperienceEntry[];
  locale: string;
  presentLabel: string;
}

const { entries, locale, presentLabel } = Astro.props;
---

{entries.map((entry) => (
  <article class="mt-[9.7pt] first:mt-0">
    <EntryRow>
      <span class="font-bold">{entry.organization}</span>
      <span class="font-bold whitespace-nowrap">{entry.location}</span>
    </EntryRow>
    <EntryRow>
      <span>{entry.role}</span>
      <span class="italic whitespace-nowrap">{formatRange(entry.startDate, entry.endDate, locale, presentLabel)}</span>
    </EntryRow>
    <Bullets items={entry.highlights} />
  </article>
))}
