---
import { formatRange } from '@scripts/utils/dates';
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useTranslations, useResume } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { experiences } = useResume(locale);
---

<Section title={t('experience.title')}>
  {experiences.map(({ organization, role, location, startDate, endDate, highlights }) => (
    <article class="px-2 border flex flex-col gap-2">
      <header class="flex items-start gap-4 justify-between">
        <div class="flex flex-col">
          <span class="font-bold">{organization}</span>
          <span>{role}</span>
        </div>
        <div class="flex flex-col items-end">
          <span class="font-bold whitespace-nowrap">{location}</span>
          <span class="italic whitespace-nowrap">{formatRange(startDate, endDate, locale, t('labels.present'))}</span>
        </div>
      </header>
      <ul class="flex flex-col gap-0.5 ml-12">
        {highlights.map((highlight) => (
          <li class="relative before:absolute before:top-2 before:rounded-full before:-left-7 before:size-1.5 before:bg-black">
            {highlight}
          </li>
        ))}
      </ul>
    </article>
  ))}
</Section>
