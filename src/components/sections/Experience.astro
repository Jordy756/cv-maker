---
import { formatRange } from '@scripts/utils/dates';
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useTranslations, useResume } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { experiences } = useResume(locale);
---

<Section title={t('experience.title')}>
  {experiences.map(({ organization, role, location, startDate, endDate, highlights }) => (
    <article class="flex flex-col gap-0.5">
      <header class="flex items-start gap-4 justify-between">
        <div class="flex flex-col">
          <h3>{organization}</h3>
          <h4>{role}</h4>
        </div>
        <div class="flex flex-col items-end">
          <span class="whitespace-nowrap">{location}</span>
          <span class="whitespace-nowrap">{formatRange(startDate, endDate, locale, t('labels.present'))}</span>
        </div>
      </header>
      <ul class="flex flex-col ml-12">
        {highlights.map((highlight) => (
          <li class="relative before:absolute before:top-0 before:-left-6 before:content-['\25CF'] before:text-xs">
            {highlight}
          </li>
        ))}
      </ul>
    </article>
  ))}
</Section>
