---
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useTranslations, useResume } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { skills } = useResume(locale);
---

<Section title={t('skills.title')}>
  <ul class="flex flex-col gap-0.5 ml-12">
    {skills.map(({ category, items }) => (
      <li class="relative before:absolute before:top-2 before:rounded-full before:-left-6 before:size-1.5 before:bg-black">
        <span class="font-bold">{category}:</span> {items.join(', ')}.
      </li>
    ))}
  </ul>
</Section>
