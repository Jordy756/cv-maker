---
import { getCurrentLocale, useResume } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const { basics } = useResume(locale);

const { name, location, portfolioLabel, portfolioUrl, phone, email } = basics;
---

<header class="text-center w-9/12 mx-auto">
  <h1>{name}</h1>
  <hr class="my-1" />
  <p>
    <span>{location}</span>
    <span> · </span>
    <a href={portfolioUrl} class="text-blue-700 underline" target="_blank" rel="noopener noreferrer">
      {portfolioLabel}
    </a>
    <span>
      {' '}
      · {email} · {phone}
    </span>
  </p>
</header>
